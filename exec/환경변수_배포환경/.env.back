# ===============================================
# Spring 애플리케이션 설정
# ===============================================
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ===============================================
# MySQL 데이터베이스 설정 (프로덕션)
# ===============================================
DB_HOST_PROD=orakgaraki-mysql
DB_PORT_PROD=3306
DB_NAME_PROD=orakgaraki
DB_USERNAME_PROD=orak_user
DB_PASSWORD_PROD=password
# ===============================================
# Redis 설정
# ===============================================
REDIS_HOST=orakgaraki-redis
REDIS_PORT=6379
REDIS_PASSWORD=password


# MySQL Exporter(도커 컴포즈)
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=exporter_password_prod_2024


# ===========================================
# Kafka 설정 (운영)
# ===========================================
KAFKA_BOOTSTRAP_SERVERS=orakgaraki-kafka:9092
KAFKA_CONSUMER_GROUP=orakgaraki-processing-prod
KAFKA_PORT=9092
KAFKA_UI_PORT=8090

# ===========================================
# 모니터링 스택 설정 (운영)
# ===========================================
# Prometheus
PROMETHEUS_PORT=9095
PROMETHEUS_ACTUATOR_USER=prod_actuator_user
PROMETHEUS_ACTUATOR_PASSWORD=prod_actuator_secure_pass_2024
SPRING_APP_TARGET=orakgaraki-app:8091

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=prod_grafana_secure_123!@#
GRAFANA_SECRET_KEY=orakgaraki-grafana-prod-secret-key-2024

# Loki
LOKI_PORT=3100
LOKI_AUTH_ENABLED=true
LOKI_CACHE_SIZE=200
LOKI_INGESTION_RATE=32
LOKI_INGESTION_BURST=64
LOKI_MAX_STREAMS=50000
LOKI_MAX_LINE_SIZE=512000
LOKI_RETENTION=30d

# Alertmanager
ALERTMANAGER_PORT=9093

# Mattermost Webhook (운영)
MATTERMOST_WEBHOOK_URL=https://meeting.ssafy.com/hooks/your-webhook-url

# Internal Webhook (Alertmanager -> Spring Boot)
ALERTMANAGER_WEBHOOK_URL=http://orakgaraki-app:8080/api/webhook/alertmanager

# ===========================================
# EventBridge Webhook 설정 (운영)
# ===========================================
ORAK_EVENTBRIDGE_WEBHOOK_TOKEN=orak-s3-eventbridge-webhook-2025-prod-secure-token

# ===========================================
# Actuator Security 설정(운영)
# ===========================================
ACTUATOR_USER=prod_actuator_user
ACTUATOR_PASSWORD=prod_actuator_secure_pass_2024
ACTUATOR_ROLE_NAME=ACTUATOR

# ===========================================
# Nginx Basic Auth 설정 (운영)
# ===========================================
NGINX_BASIC_AUTH_USER=monitoring_admin
NGINX_BASIC_AUTH_PASSWORD=orak_monitoring_secure_2024


# ===============================================
# Google OAuth2 설정 (프로덕션)
# ===============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://j13c103.p.ssafy.io/api/login/oauth2/code/google

# OAuth2 리다이렉트 URI
OAUTH2_REDIRECT_URI=https://j13c103.p.ssafy.io/login/success


# ===========================================
# AWS 설정
# ===========================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=ssafy-orak-s3-bucket
AWS_EVENTBRIDGE_BUS_NAME=default

# ===============================================
# 업로드 경로 설정
# ===============================================
ORAK_UPLOAD_PATH=/app/uploads

# ===========================================
# JWT 설정
# ===========================================
JWT_SECRET=your-secure-jwt-secret-key-2025
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ===========================================
# CORS 설정
# ===========================================
CORS_ALLOWED_ORIGINS=https://j13c103.p.ssafy.io

# ===========================================
# Swagger 설정
# ===========================================
SWAGGER_ENABLED=false

# ===========================================
# 외부 도메인 설정
# ===========================================
EXTERNAL_DOMAIN=j13c103.p.ssafy.io

# ===========================================
# Grafana URL 설정
# ===========================================
GRAFANA_ROOT_URL=http://localhost:3000/grafana/
GRAFANA_DOMAIN=j13c103.p.ssafy.io

# ===========================================
# Profile Image 설정
# ===========================================
PROFILE_IMAGE_BASE_URL=https://j13c103.p.ssafy.io

# ===========================================
# 로깅 설정
# ===========================================
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO
LOG_LEVEL_SQL=WARN

# Log file path (Production)
LOG_FILE_PATH=/var/log/app

# ===============   ============================
# Promtail 설정
# ===========================================
PROMTAIL_READLINE_RATE=20000
PROMTAIL_MAX_STREAMS=10000
PYTHON_SERVICE_URL=http://data-service:8000